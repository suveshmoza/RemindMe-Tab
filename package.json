{
    "name": "remindme-tab",
    "description": "Set reminders for tabs so you never lose track of pages you want to revisit.",
    "private": true,
    "version": "2.0.0",
    "author": "Suvesh Moza <suveshmoza@gmail.com> (https://suveshmoza.vercel.app)",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "zip:edge": "wxt zip -b edge",
        "compile": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
        "postinstall": "wxt prepare"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@wxt-dev/auto-icons": "^1.1.1",
        "@wxt-dev/module-react": "^1.2.2",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "wxt": "^0.20.26"
    },
    "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40",
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@tailwindcss/vite": "^4.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.3.0",
        "lucide-react": "^1.16.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0"
    }
}